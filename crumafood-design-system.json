      },
      "stat": {
        "background": "#2C2C2C", "color": "#FAFAF8",
        "borderRadius": "12px", "padding": "32px 24px", "textAlign": "center"
      }
    },

    "priceBlock": {
      "layout": "grid-2-columns",
      "strategy": "Efecto Anclaje — Menudeo visible primero, Mayoreo como incentivo de volumen",
