        "body": "'Lato', Helvetica, sans-serif",
        "technical": "'IBM Plex Mono', monospace",
        "accent": "'Libre Baskerville', Georgia, serif"
      },
      "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;900&family=Cormorant+Garamond:wght@300;400;600&family=Lato:wght@300;400;700&family=IBM+Plex+Mono:wght@400;500&family=Libre+Baskerville:ital,wght@0,400;1,400&display=swap",
      "scale": {
        "hero":     { "size": "clamp(3rem, 7vw, 6rem)",   "lineHeight": "1.05", "letterSpacing": "-0.02em",  "fontFamily": "display",  "weight": "700" },
        "h1":       { "size": "clamp(2rem, 4vw, 3.5rem)", "lineHeight": "1.1",  "letterSpacing": "-0.015em", "fontFamily": "display",  "weight": "600" },
        "h2":       { "size": "clamp(1.5rem, 3vw, 2.5rem)","lineHeight": "1.2", "letterSpacing": "-0.01em",  "fontFamily": "heading",  "weight": "600" },
        "h3":       { "size": "clamp(1.25rem, 2vw, 1.75rem)","lineHeight": "1.3","fontFamily": "heading",    "weight": "400" },
        "h4":       { "size": "1.25rem",   "lineHeight": "1.4", "fontFamily": "body",      "weight": "700" },
        "body":     { "size": "1rem",      "lineHeight": "1.7", "fontFamily": "body",      "weight": "300" },
        "bodyLarge":{ "size": "1.125rem",  "lineHeight": "1.7", "fontFamily": "body",      "weight": "300" },
        "caption":  { "size": "0.8125rem", "lineHeight": "1.5", "fontFamily": "technical", "weight": "400", "letterSpacing": "0.05em", "textTransform": "uppercase" },
        "label":    { "size": "0.75rem",   "lineHeight": "1.4", "fontFamily": "technical", "weight": "500", "letterSpacing": "0.1em",  "textTransform": "uppercase" },
        "price":    { "size": "1.5rem",    "lineHeight": "1.2", "fontFamily": "display",   "weight": "700" }
      }
    },

    "spacing": {
      "base": "8px",
      "scale": {
        "xs": "4px", "sm": "8px", "md": "16px", "lg": "24px",
        "xl": "40px", "2xl": "64px", "3xl": "96px", "4xl": "128px",
        "section": "clamp(64px, 10vw, 120px)"
      }
    },

    "borderRadius": {
      "none": "0px", "sm": "4px", "md": "8px",
      "lg": "16px", "xl": "24px", "pill": "999px", "card": "12px"
    },

    "shadows": {
      "subtle":  "0 2px 8px rgba(44,44,44,0.06)",
      "card":    "0 4px 24px rgba(44,44,44,0.10)",
      "elevated":"0 8px 40px rgba(44,44,44,0.14)",
      "product": "0 12px 48px rgba(44,44,44,0.18)",
      "natural": "6px 12px 32px rgba(184,134,11,0.12)"
    },

    "grid": {
      "columns": 12,
      "gap": "24px",
      "maxWidth": "1280px",
      "containerPadding": "clamp(16px, 5vw, 80px)",
      "breakpoints": {
        "mobile": "0px", "tablet": "768px",
        "desktop": "1024px", "wide": "1280px"
      }
    },

    "motion": {
      "duration": { "fast": "150ms", "normal": "300ms", "slow": "500ms", "reveal": "800ms" },
      "easing": {
        "standard":   "cubic-bezier(0.4, 0, 0.2, 1)",
        "decelerate": "cubic-bezier(0, 0, 0.2, 1)",
        "accelerate": "cubic-bezier(0.4, 0, 1, 1)",
        "artisan":    "cubic-bezier(0.25, 0.46, 0.45, 0.94)"
      }
    }
  },

