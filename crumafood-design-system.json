        "unit":   { "fontFamily": "technical", "fontSize": "0.75rem", "color": "#6B6B6B" },
        "divider": "1px solid #D6D3CC"
      }
    },

    "categoryTag": {
      "background": "#E8DCC8", "color": "#2C2C2C", "borderRadius": "999px",
      "padding": "4px 12px", "fontFamily": "technical",
      "fontSize": "0.7rem", "letterSpacing": "0.08em", "textTransform": "uppercase"
