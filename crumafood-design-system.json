        "pearlGrayDark": "#A8A49C"
      },
      "accent": {
        "goldenCrust": "#B8860B",
        "goldenCrustLight": "#D4A017",
        "goldenCrustDark": "#8B6508"
      },
      "neutral": {
        "charcoal": "#2C2C2C",
        "darkGray": "#3E3E3E",
        "midGray": "#6B6B6B",
        "lightGray": "#F0EDE8",
        "white": "#FAFAF8"
