        "hover": { "background": "#2C2C2C", "color": "#FAFAF8" }
      },
      "download": {
        "background": "#B8860B", "color": "#FAFAF8", "border": "none",
        "borderRadius": "4px", "padding": "14px 32px",
        "fontFamily": "technical", "fontSize": "0.75rem",
        "letterSpacing": "0.1em", "textTransform": "uppercase",
        "display": "flex", "gap": "10px", "alignItems": "center", "icon": "download-cloud"
      }
    },

    "cards": {
      "product": {
        "background": "#FFFFFF", "borderRadius": "12px",
        "border": "1px solid #EDEDEA", "boxShadow": "0 4px 24px rgba(44,44,44,0.10)",
        "overflow": "hidden",
        "hover": { "transform": "translateY(-6px)", "boxShadow": "0 12px 48px rgba(44,44,44,0.18)" },
        "imageAspectRatio": "4/3", "imageObjectFit": "cover", "padding": "24px",
        "structure": ["image", "category-tag", "product-name", "description", "price-block", "cta"]
      },
      "feature": {
        "background": "#F4EFE6", "borderRadius": "12px", "padding": "32px",
