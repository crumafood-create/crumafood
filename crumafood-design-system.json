{
  "brand": {
    "name": "Crumafood",
    "tagline": "La Ciencia del Sabor, el Arte de la Masa",
    "origin": "Fundada por venezolanos, fabricada con orgullo en Toluca, Estado de México",
    "concept": "Maestro Artesano — El balance perfecto entre la ingeniería del laminado y la tradición del sabor.",
    "market": "México (B2C y B2B — sector HORECA)",
    "productLine": "Alimentos congelados premium con cadena de frío garantizada",
    "mission": "Elevar los estándares de la comida preparada combinando precisión industrial con respeto por la receta artesanal."
  },

  "designTokens": {
    "colors": {
      "primary": {
        "sand": "#E8DCC8",
        "sandLight": "#F4EFE6",
        "sandDark": "#C9B99A"
